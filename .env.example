# GTech — variaveis de ambiente
# Copie para .env e ajuste: cp .env.example .env

# Porta onde a API sobe (usada em src/server.ts)
PORT=3000

# Banco: migrations usam POSTGRES_USER; a API usara APP_DB_USER
POSTGRES_USER=gtech
POSTGRES_PASSWORD=gtech
POSTGRES_DB=gtech
APP_DB_USER=gtech_app
APP_DB_PASSWORD=gtech_app
DATABASE_URL=postgresql://gtech_app:gtech_app@localhost:5432/gtech?schema=public
DIRECT_URL=postgresql://gtech:gtech@localhost:5432/gtech?schema=public

# pgAdmin (http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@gtech.dev
PGADMIN_DEFAULT_PASSWORD=gtech
